# Copy this file to .env in the observability/ directory before running
# `docker compose up -d`. Never commit .env to version control.

# Grafana admin account password (user: admin). Use a long random value,
# e.g. `openssl rand -base64 24`. Grafana is internet-exposed at
# logs.fitznet.org, so this must be strong.
GRAFANA_ADMIN_PASSWORD=
