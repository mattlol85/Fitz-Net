# Copy this file to .env and fill in the values before running docker-compose.
# Never commit .env to version control.

# MongoDB
MONGO_DATABASE=fitznet
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=

# fitz-net-api secrets
JWT_SECRET=
# Optional: lets scripts manage user permissions via the X-Admin-Key header. Leave empty to disable.
ADMIN_API_KEY=
ENCRYPTION_KEY=
