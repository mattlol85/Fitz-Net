# Copy this file to .env and fill in the values before running docker-compose.
# Never commit .env to version control.

# MongoDB
MONGO_DATABASE=fitznet
# Root credentials — MongoDB enables authentication when these are set.
# Use a long random password (e.g. `openssl rand -base64 24`).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# fitz-net-api secrets
JWT_SECRET=
ENCRYPTION_KEY=
